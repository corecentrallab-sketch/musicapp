# NoteSnap environment variables (copy to .env / .env.local and fill in)

# ── Cloud sync (Phase 4b) ─────────────────────────────────────
# Dropbox OAuth app (https://www.dropbox.com/developers/apps/create):
#   App type: Scoped access → App folder (or Full Dropbox if you prefer)
#   Permissions: account_info.read, files.metadata.read, files.content.read,
#                files.content.write
#   Redirect URIs: add the app's OAuth redirect (notesnap://oauthredirect for
#                  standalone builds; use `expo start` to see the dev URI)
# The app key is public (ships in the binary). The secret is optional when the
# app uses PKCE — include it if you configured a confidential app.
EXPO_PUBLIC_DROPBOX_APP_KEY=
EXPO_PUBLIC_DROPBOX_APP_SECRET=

# Google OAuth client (https://console.cloud.google.com/apis/credentials):
#   Create an OAuth client ID of type "Android" (package com.notesnap.app)
#   → EXPO_PUBLIC_GOOGLE_CLIENT_ID (and the SHA-1 of your signing key).
#   Create an "iOS" client (bundle id com.notesnap.app) for iOS builds
#   → EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID (optional on Android-only builds).
#   Enable the Google Drive API for the project.
# Scopes used by the app: https://www.googleapis.com/auth/drive.file
# Redirect URI: <android application id>:/oauthredirect
#               (e.g. com.notesnap.app:/oauthredirect) — native clients are
#               matched by client id, no URI registration needed.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# ── Recognition API (existing) ─────────────────────────────────
# EXPO_PUBLIC_API_URL=https://site-notesnap.vercel.app (optional override; the app defaults to this stable URL)
