{
  "expo": {
    "name": "NoteSnap",
    "slug": "notesnap",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "owner": "notesnap",
    "privacyPolicyUrl": "https://0eb3ebd375af606892cd883ecc4906b1.ctonew.app/privacy",
    "splash": {
      "backgroundColor": "#1a1a2e"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.notesnap.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "NoteSnap uses your microphone to identify music playing around you."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1a1a2e"
      },
      "package": "com.notesnap.app",
      "permissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-notifications", "expo-av"]
  }
}
