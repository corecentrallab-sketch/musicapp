{
  "expo": {
    "name": "NoteSnap: Sheet Music",
    "slug": "notesnap",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "notesnap",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "owner": "notesnaps-team",
    "privacyPolicyUrl": "https://site-notesnap.vercel.app/privacy",
    "splash": {
      "backgroundColor": "#1a1a2e"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.notesnap.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "NoteSnap uses your microphone to identify music playing around you.",
        "NSCameraUsageDescription": "NoteSnap uses your camera to scan sheet music pages into your library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1a1a2e"
      },
      "package": "com.notesnap.sheetmusic",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "versionCode": 10,
      "versionName": "0.1.5"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-notifications",
      "expo-av",
      [
        "expo-camera",
        {
          "cameraPermission": "NoteSnap uses your camera to scan sheet music pages into your library."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "targetSdkVersion": 36,
            "compileSdkVersion": 36,
            "useLegacyPackaging": false
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "332b6f47-e7e3-4208-bbd5-b8d78383f8f2"
      }
    }
  }
}